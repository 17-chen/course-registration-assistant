{
  "name": "wku-course-registration-assistant",
  "version": "0.1.1",
  "private": true,
  "description": "A local, user-started course registration assistant for Ellucian Colleague Self-Service.",
  "author": "17-chen",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "build:mac": "electron-builder --mac dmg --arm64",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/browser-session.js && node --check src/registration-runner.js && node --check electron/main.js && node --test"
  },
  "dependencies": {
    "playwright-core": "^1.55.0",
    "selenium-webdriver": "^4.35.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.wkucourseassistant",
    "productName": "WKU Course Assistant",
    "asar": false,
    "afterPack": "electron/after-pack.cjs",
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "WKU Course Assistant ${version}",
      "artifactName": "WKU-Course-Assistant-${version}-${arch}.${ext}"
    }
  }
}
